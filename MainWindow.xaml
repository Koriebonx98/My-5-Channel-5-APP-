<Window x:Class="My5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="My 5"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black">
    <Grid x:Name="MainGrid">
        <!-- WebView2 for browsing -->
        <wv2:WebView2 x:Name="webView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <!-- MediaElement for ad-free playback (hidden until used) -->
        <MediaElement x:Name="player"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Visibility="Collapsed"
                      Stretch="Uniform" />

        <!-- Simple download progress -->
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"
                    Visibility="Collapsed"
                    x:Name="DownloadPanel">
            <ProgressBar x:Name="DownloadProgress"
                         Width="300"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
            <TextBlock x:Name="DownloadText"
                       Foreground="White"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
